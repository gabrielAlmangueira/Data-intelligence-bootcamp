# --- Kaggle API ---
# Seu username do Kaggle (visível na URL do seu perfil: kaggle.com/<username>)
KAGGLE_USERNAME=seu_username_aqui
# Sua API Key gerada em: Kaggle → Settings → API → Create New Token
KAGGLE_API_TOKEN=sua_api_key_aqui

# --- PostgreSQL ---
DB_USER=postgres
DB_PASS=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projeto_bi
